{
  "manifest_version": 2,
  "name": "Context Before Consequence",
  "version": "1.0",
  "description": "Privacy-preserving digital assistant showing minimum necessary context before high-consequence actions",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Context Before Consequence",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
